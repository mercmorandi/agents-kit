# expect-left: CANONICAL_ENTITY CANONICAL_RESOURCE
PROJECT_NAME=demo
PROJECT_SHAPE=fullstack
FE_DIR=client
FE_PACKAGE_MANAGER=pnpm
BE_LANGUAGE=python
BE_DIR=server
BE_PACKAGE_MANAGER=uv
DATABASE=postgres
REDIS=no
CI=yes
CHAT_LANGUAGE=Italian
CODE_LANGUAGE=English
DOC_LANGUAGE=English
AGENT_COMMITS=never
COMMIT_TITLE_MAX=50
MILESTONE_CADENCE=stop after each milestone
GIT_REMOTE_POLICY=never fetch, pull or push
ENVIRONMENTS=local only
PLAN_DATES_POLICY=no dates
AUTH=none
NODE_VERSION=22
PNPM_VERSION=10.13.1
PYTHON_VERSION=3.12
INSTALL_CMD=$(MAKE) install-frontend install-backend
FE_INSTALL_CMD=pnpm install
BE_INSTALL_CMD=uv sync
FE_STACK=Next.js
FE_PORT=3000
FE_DEV_CMD=pnpm dev
FE_LINT_CMD=pnpm lint
FE_FORMAT_CMD=pnpm exec prettier --write .
FE_TYPECHECK_CMD=pnpm exec tsc --noEmit
FE_TEST_CMD=pnpm test
FE_TEST_SINGLE_CMD=pnpm exec vitest run
FE_BUILD_CMD=pnpm build
BE_FRAMEWORK=FastAPI
BE_PORT=8000
BE_ASGI_APP=src.api.main:app
BE_DEV_CMD=uv run uvicorn src.api.main:app --reload --port 8000
BE_LINT_CMD=uv run ruff check .
BE_FORMAT_CMD=uv run ruff format .
BE_TYPECHECK_CMD=uv run mypy src
BE_TEST_CMD=uv run pytest -q
BE_TEST_SINGLE_CMD=uv run pytest -q
BE_BUILD_CMD=uv run python -m compileall -q src
BE_MIGRATE_CMD=uv run alembic upgrade head
MAIN_BRANCH=master
DEV_BRANCH=develop
EXTERNAL_ID_NAME=ref
PAGE_DEFAULT_LIMIT=25
PAGE_MAX_LIMIT=100
