FE_DEV_CMD=npm run dev
FE_LINT_CMD=npm run lint
FE_FORMAT_CMD=npx prettier --write .
FE_TYPECHECK_CMD=npx tsc --noEmit
FE_TEST_CMD=npm test
FE_TEST_SINGLE_CMD=npx vitest run
FE_BUILD_CMD=npm run build
EXTERNAL_ID_NAME=ref
