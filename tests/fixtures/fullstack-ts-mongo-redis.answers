# expect-left:
PROJECT_NAME=acme
PROJECT_SHAPE=fullstack
FE_DIR=client
FE_PACKAGE_MANAGER=pnpm
BE_LANGUAGE=typescript
BE_DIR=server
BE_PACKAGE_MANAGER=pnpm
DATABASE=mongo
REDIS=yes
CI=yes
CHAT_LANGUAGE=Italian
CODE_LANGUAGE=English
DOC_LANGUAGE=English
AGENT_COMMITS=never
COMMIT_TITLE_MAX=50
MILESTONE_CADENCE=stop after each milestone
GIT_REMOTE_POLICY=never fetch, pull or push
ENVIRONMENTS=dev only
PLAN_DATES_POLICY=no dates
AUTH=Auth0
NODE_VERSION=22
PNPM_VERSION=10.13.1
INSTALL_CMD=pnpm install
FE_INSTALL_CMD=pnpm install --filter "@acme/client..."
BE_INSTALL_CMD=pnpm install --filter "@acme/server..."
FE_STACK=Next.js 15
FE_PORT=3000
FE_PACKAGE_NAME=@acme/client
FE_DEV_CMD=pnpm dev
FE_LINT_CMD=pnpm lint
FE_FORMAT_CMD=pnpm exec prettier --write .
FE_TYPECHECK_CMD=pnpm exec tsc --noEmit
FE_TEST_CMD=pnpm test
FE_TEST_SINGLE_CMD=pnpm exec vitest run
FE_BUILD_CMD=pnpm build
BE_FRAMEWORK=Express
BE_PORT=4000
BE_PACKAGE_NAME=@acme/server
BE_ENTRYPOINT=dist/server.js
BE_DEV_CMD=pnpm dev
BE_LINT_CMD=pnpm lint
BE_FORMAT_CMD=pnpm exec prettier --write .
BE_TYPECHECK_CMD=pnpm exec tsc --noEmit -p tsconfig.build.json
BE_TEST_CMD=pnpm test
BE_TEST_SINGLE_CMD=pnpm exec jest --runInBand
BE_BUILD_CMD=pnpm build
MAIN_BRANCH=master
DEV_BRANCH=develop
EXTERNAL_ID_NAME=ref
PAGE_DEFAULT_LIMIT=25
PAGE_MAX_LIMIT=100
CANONICAL_ENTITY=organization
CANONICAL_RESOURCE=organizations
