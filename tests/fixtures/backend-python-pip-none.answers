# expect-left:
PROJECT_NAME=pyapi
PROJECT_SHAPE=backend
BE_LANGUAGE=python
BE_DIR=.
BE_PACKAGE_MANAGER=pip
DATABASE=none
REDIS=no
CI=yes
CHAT_LANGUAGE=English
CODE_LANGUAGE=English
DOC_LANGUAGE=English
AGENT_COMMITS=on request
COMMIT_TITLE_MAX=72
MILESTONE_CADENCE=chain until told
GIT_REMOTE_POLICY=may fetch; never push
ENVIRONMENTS=local only
PLAN_DATES_POLICY=dates allowed
AUTH=none
PYTHON_VERSION=3.12
INSTALL_CMD=pip install -r requirements.txt -r requirements-dev.txt
BE_INSTALL_CMD=pip install -r requirements.txt -r requirements-dev.txt
BE_FRAMEWORK=FastAPI
BE_PORT=8000
BE_ASGI_APP=app.main:app
BE_DEV_CMD=uvicorn app.main:app --reload
BE_LINT_CMD=ruff check .
BE_FORMAT_CMD=ruff format .
BE_TYPECHECK_CMD=mypy app
BE_TEST_CMD=pytest -q
BE_TEST_SINGLE_CMD=pytest -q
BE_BUILD_CMD=python -m compileall -q app
BE_MIGRATE_CMD=alembic upgrade head
MAIN_BRANCH=main
DEV_BRANCH=main
EXTERNAL_ID_NAME=public_id
PAGE_DEFAULT_LIMIT=20
PAGE_MAX_LIMIT=200
CANONICAL_ENTITY=user
CANONICAL_RESOURCE=users
