# syntax=docker/dockerfile:1
# Node/TypeScript backend. Multi-stage: builder → runner. Runs as a non-root
# user; the compiled output is in dist/.
# {{IF BE_ROOT_CONTEXT}}
# Workspace build: the context is the repository root (pnpm workspace shared
# with the frontend); only this workspace and its dependencies are installed.
# {{ENDIF}}

ARG NODE_VERSION={{NODE_VERSION}}
ARG PNPM_VERSION={{PNPM_VERSION}}
FROM node:${NODE_VERSION}-alpine AS builder
ARG PNPM_VERSION
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
# {{IF BE_ROOT_CONTEXT}}
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY {{BE_DIR}}/package.json ./{{BE_DIR}}/
# Add the package.json of every workspace package the backend depends on:
# COPY packages/shared/package.json ./packages/shared/
RUN pnpm install --frozen-lockfile --filter "{{BE_PACKAGE_NAME}}..."
COPY . .
# build, then prune to the production dependencies of this workspace only
RUN pnpm --filter "{{BE_PACKAGE_NAME}}..." run build \
    && pnpm --filter "{{BE_PACKAGE_NAME}}" deploy --prod /out
# {{ENDIF}}
# {{IF BE_DIR_CONTEXT}}
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm run build && pnpm prune --prod
# {{ENDIF}}

FROM node:${NODE_VERSION}-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 app \
    && apk add --no-cache curl
# {{IF BE_ROOT_CONTEXT}}
COPY --from=builder --chown=app:nodejs /out ./
# {{ENDIF}}
# {{IF BE_DIR_CONTEXT}}
COPY --from=builder --chown=app:nodejs /app/package.json ./
COPY --from=builder --chown=app:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=app:nodejs /app/dist ./dist
# {{ENDIF}}
USER 1001:1001
ENV PORT={{BE_PORT}}
EXPOSE {{BE_PORT}}
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD ["curl", "-fsS", "http://127.0.0.1:{{BE_PORT}}/health"]
CMD ["node", "{{BE_ENTRYPOINT}}"]
